[Unit]
Description=Moon Yarn Spinner workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/podman run --rm --replace --name moon-yarn-workbench --sdnotify=conmon --read-only --cap-drop=ALL --security-opt=no-new-privileges --memory=768m --pids-limit=128 --publish=127.0.0.1:18849:18849 --volume=/var/lib/moon-yarn-workbench:/data --env-file=/etc/moon-yarn-workbench/sso-client.env localhost/moon-yarn-workbench:1.0.0
ExecStop=/usr/bin/podman stop --ignore --time=10 moon-yarn-workbench
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
